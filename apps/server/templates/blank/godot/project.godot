config_version=5

[application]
config/name="{{GAME_NAME_ESCAPED}}"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; GameState is the game's single source of truth and StudioProbe is the
; read-only bridge game_web_playtest reads from. Keep both names. Juice is
; the game feel kit (shell/juice.gd).
GameState="*res://scripts/game_state.gd"
StudioProbe="*res://scripts/studio_probe.gd"
Juice="*res://shell/juice.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/custom="res://shell/theme.tres"

[input]

; The game's controls: named actions with keyboard, mouse and gamepad defaults.
; Gameplay reads them (Input.get_vector("move_left", "move_right", "move_up",
; "move_down"), Input.is_action_just_pressed("jump")), never raw keys, and the
; shell's Settings > Controls screen lists every action here and rebinds its
; keys. Add the game's own as one more line; delete the ones it never reads;
; pause belongs to the shell. Keep "device":-1 (any device). physical_keycode:
; a letter's capital ASCII code (A 65, L 76), Space 32, Enter 4194309, Shift
; 4194325, Tab 4194306, Left 4194319, Up 4194320, Right 4194321, Down 4194322.
; Gamepad button_index: 0 A, 1 B, 2 X, 3 Y, 6 Start, 9 LB, 10 RB, 11-14 d-pad
; up/down/left/right; JoypadMotion axis 0/1 is the left stick (axis_value -1
; left or up, 1 right or down), 4/5 the triggers. Mouse button_index: 1 left,
; 2 right.
move_left={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":13)]}
move_right={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":14)]}
move_up={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0), Object(InputEventJoypadButton,"device":-1,"button_index":11)]}
move_down={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventKey,"device":-1,"physical_keycode":4194322), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":12)]}
jump={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]}
action={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":74), Object(InputEventKey,"device":-1,"physical_keycode":4194309), Object(InputEventJoypadButton,"device":-1,"button_index":2), Object(InputEventMouseButton,"device":-1,"button_index":1)]}
alt={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":75), Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":1)]}
pause={"deadzone": 0.25, "events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventKey,"device":-1,"physical_keycode":80), Object(InputEventJoypadButton,"device":-1,"button_index":6)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)
