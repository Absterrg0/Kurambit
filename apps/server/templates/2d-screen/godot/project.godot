; Engine configuration for the 2d-screen starter template.
; Inside every quoted string, {{GAME_NAME_ESCAPED}} is substituted with the
; game name escaped for a Godot string literal, so quotes and backslashes in
; the name cannot corrupt this file.

config_version=5

[application]

config/name="{{GAME_NAME_ESCAPED}}"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.055, 0.078, 0.125, 1)

[autoload]

GameState="*res://scripts/game_state.gd"
Audio="*res://scripts/audio.gd"
StudioProbe="*res://scripts/studio_probe.gd"

[display]

; Containers reflow in window pixels; scaling the design frame makes text and
; touch targets too small in a narrow window.
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"

[gui]

theme/custom="res://ui/theme.tres"

[input]

choose_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
choose_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
choose_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
listen={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":76)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":5)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.078, 0.125, 1)
